# Copy to .env (project root) and fill in yourself. Never commit the real file.

# NVIDIA API Catalog key (starts with nvapi-), from build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
IMAGE_MODEL=meta/muse-glimmer-30b
TEXT_MODEL=z-ai/glm-5.3

# Global pacing across both models (requests per minute) and calls in flight
LLM_RPM=30
LLM_MAX_IN_FLIGHT=4

# Postgres (docker-compose.yml publishes it on host port 5433)
DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5433/invoice_analyst

# Held-out set: choose your own number privately; only its hash is recorded
HELDOUT_SEED=
